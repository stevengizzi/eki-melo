# Backups folder — all contents ignored, but keep the directory in repo
backups/*
!backups/README.md

# Catch any backup JSONs that end up outside backups/ by accident
eki-greetings-backup-*.json
*-backup-*.json

# Secrets — never commit these. Examples files (.example suffix) are OK to commit.
.env
.env.local
.env.*.local
.dev.vars
.dev.vars.local

# Wrangler local state (Cloudflare CLI)
.wrangler/

# Node — only relevant if wrangler ever installs locally
node_modules/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~